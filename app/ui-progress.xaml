<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="磁盘开关" Width="476" Height="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <!-- 外圈留白给阴影 -->
  <Border x:Name="Card" CornerRadius="14" Margin="8"
          Background="#FFFFFF" BorderBrush="#E5EAF1" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270"
                        Color="#1F2937" Opacity="0.16"/>
    </Border.Effect>

    <Grid Margin="26,22,26,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 标题行：状态点 + 大标题 + 右侧百分比 -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#109B5E"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="TitleText" Text="正在挂载…"
                     FontSize="19" FontWeight="SemiBold" Foreground="#171C26"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="PercentText" Grid.Column="1" Text="" FontSize="11"
                   Foreground="#848D9E" VerticalAlignment="Center"/>
      </Grid>

      <!-- 状态副行 -->
      <TextBlock x:Name="StatusText" Grid.Row="1" Text="准备中…"
                 FontSize="12" Foreground="#848D9E" Margin="22,8,0,0"
                 TextTrimming="CharacterEllipsis"/>

      <!-- 进度条 -->
      <Grid x:Name="TrackGrid" Grid.Row="2" Height="6" Margin="22,16,0,0" HorizontalAlignment="Stretch">
        <Border CornerRadius="3" Background="#EEF2F7"/>
        <Border x:Name="ProgressFill" CornerRadius="3" Background="#109B5E"
                HorizontalAlignment="Left" Width="0"/>
      </Grid>

      <!-- 结果行 -->
      <TextBlock x:Name="FootText" Grid.Row="3" Text=""
                 FontSize="11.5" Foreground="#848D9E" Margin="22,14,0,0"
                 TextWrapping="Wrap" VerticalAlignment="Top"/>
    </Grid>
  </Border>
</Window>
