<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="磁盘开关" Width="476" Height="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <!-- 外圈留白给阴影 -->
  <Border x:Name="Card" CornerRadius="14" Margin="8"
          Background="#FFFFFF" BorderBrush="#E5EAF1" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270"
                        Color="#1F2937" Opacity="0.16"/>
    </Border.Effect>

    <Grid Margin="26,22,26,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 标题行：状态点 + 大标题 + 右侧百分比 -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#109B5E"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="TitleText" Text="正在挂载…"
                     FontSize="19" FontWeight="SemiBold" Foreground="#171C26"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="PercentText" Grid.Column="1" Text="" FontSize="11"
                   Foreground="#848D9E" VerticalAlignment="Center"/>
      </Grid>

      <!-- 状态副行 -->
      <TextBlock x:Name="StatusText" Grid.Row="1" Text="准备中…"
                 FontSize="12" Foreground="#848D9E" Margin="22,8,0,0"
                 TextTrimming="CharacterEllipsis"/>

      <!-- 进度条 -->
      <Grid x:Name="TrackGrid" Grid.Row="2" Height="6" Margin="22,16,0,0" HorizontalAlignment="Stretch">
        <Border CornerRadius="3" Background="#EEF2F7"/>
        <Border x:Name="ProgressFill" CornerRadius="3" Background="#109B5E"
                HorizontalAlignment="Left" Width="0"/>
      </Grid>

      <!-- 结果行 -->
      <TextBlock x:Name="FootText" Grid.Row="3" Text=""
                 FontSize="11.5" Foreground="#848D9E" Margin="22,14,0,0"
                 TextWrapping="Wrap" VerticalAlignment="Top"/>

      <!-- 唤醒明细（脱机期间盘被唤醒过时才显示；盘多时可滚动） -->
      <StackPanel x:Name="WakePanel" Grid.Row="4" Margin="22,16,0,0" Visibility="Collapsed">
        
        
        <Border CornerRadius="10" Background="#F7F9FC" BorderBrush="#EDF1F6" BorderThickness="1" Padding="12,10,6,10">
  <ScrollViewer x:Name="WakeScroll" MaxHeight="252"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Resources>
      <!-- 细滚动条：3px 圆角滑块，无轨道无箭头；8px 命中区域方便抓 -->
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Grid Background="Transparent">
                            <Border x:Name="Bar" Width="3" CornerRadius="1.5"
                                    Background="#CBD3DF" HorizontalAlignment="Center"/>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bar" Property="Width" Value="5"/>
                              <Setter TargetName="Bar" Property="Background" Value="#AEB8C7"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                              <Setter TargetName="Bar" Property="Width" Value="5"/>
                              <Setter TargetName="Bar" Property="Background" Value="#8E99A9"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
            </ScrollViewer.Resources>
            <StackPanel x:Name="WakeList" Margin="0,0,10,0"/>
          </ScrollViewer>
        </Border>
        <TextBlock x:Name="WakeNote" Margin="0,12,0,0" FontSize="11.5" Foreground="#4B5563"
                   TextWrapping="Wrap"
                   Text="盘在脱机期间被唤醒过，通常来自磁盘工具或系统自检。"/>
        <Button x:Name="WakeLog" Margin="0,6,0,0" HorizontalAlignment="Left" Cursor="Hand"
                Background="Transparent" BorderThickness="0" Padding="0" FontSize="10.5"
                ToolTip="点击打开日志所在文件夹">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <TextBlock x:Name="tx" Text="明细见 logs\wakeups.csv" Foreground="#A0A8B5"/>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="tx" Property="Foreground" Value="#109B5E"/>
                  <Setter TargetName="tx" Property="TextDecorations" Value="Underline"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </StackPanel>

      <!-- 需要用户确认时才显示（例如脱机期间检测到唤醒） -->
      <Button x:Name="AckButton" Grid.Row="5" Content="知道了"
              HorizontalAlignment="Right" Margin="0,14,4,0" Height="34" MinWidth="96"
              FontSize="12" Foreground="White" BorderThickness="0" Cursor="Hand"
              Visibility="Collapsed">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="8" Background="#109B5E" Padding="20,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#0E8A54"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </Grid>
  </Border>
</Window>
