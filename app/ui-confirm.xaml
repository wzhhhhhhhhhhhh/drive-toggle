<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="磁盘开关 · 初始化" Width="520" Height="270"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="20,0"/><Setter Property="MinWidth" Value="96"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="9" Background="#109B5E" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#0E8A54"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="#171C26"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="18,0"/><Setter Property="MinWidth" Value="96"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="9" Background="#F3F6FA" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E7EDF5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Card" CornerRadius="14" Margin="8"
          Background="#FFFFFF" BorderBrush="#E5EAF1" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Color="#1F2937" Opacity="0.16"/>
    </Border.Effect>

    <Grid Margin="28,22,28,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock x:Name="TitleText" Grid.Row="0" Text="已经有配置了"
                 FontSize="18" FontWeight="SemiBold" Foreground="#171C26"/>

      <TextBlock x:Name="MessageText" Grid.Row="1" Text=""
                 FontSize="13" Foreground="#4B5563" TextWrapping="Wrap"
                 Margin="0,14,0,0" VerticalAlignment="Top" LineHeight="22"/>

      <!-- 靠左，按推荐顺序：沿用 → 重新选盘 → 取消 -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
        <Button x:Name="MainBtn" Content="沿用现有配置" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" IsDefault="True"/>
        <Button x:Name="AltBtn" Content="重新选盘" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
        <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostButton}" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
